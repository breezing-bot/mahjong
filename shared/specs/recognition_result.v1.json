{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recognition_result.v1.json",
  "title": "Mahjong Recognition Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "detections",
    "layout"
  ],
  "properties": {
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tile_id",
          "confidence",
          "bbox"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "tile_id": {
            "$ref": "tile_vocab.v1.json"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bbox": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number" },
              "height": { "type": "number" }
            }
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hand",
        "hora",
        "naki",
        "unassigned"
      ],
      "properties": {
        "hand": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "hora": {
          "anyOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "naki": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "tiles",
              "needs_confirmation"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": {
                "type": "string",
                "enum": [
                  "chi",
                  "pon",
                  "daiminkan",
                  "ankan",
                  "unknown"
                ]
              },
              "tiles": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0 }
              },
              "needs_confirmation": { "type": "boolean" }
            }
          }
        },
        "unassigned": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
