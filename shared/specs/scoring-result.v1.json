{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mahjong.scoring-result.v1",
  "title": "AnalyzeHandResult",
  "type": "object",
  "required": ["yaku", "han", "fu", "points"],
  "properties": {
    "yaku": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "han"],
        "properties": {
          "name": { "type": "string" },
          "han": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "han": { "type": "integer", "minimum": 0 },
    "fu": { "type": "integer", "minimum": 0 },
    "points": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "points"],
          "properties": {
            "kind": { "const": "ron" },
            "points": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "dealer", "non_dealer"],
          "properties": {
            "kind": { "const": "tsumo" },
            "dealer": { "type": "integer", "minimum": 0 },
            "non_dealer": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
